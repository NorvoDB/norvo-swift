#!/usr/bin/env bash
# Runs what CI runs before anything reaches GitHub: CI here runs on macOS, which bills at 10x Linux.
# Enable once per clone: git config core.hooksPath .githooks. Skip in an emergency: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: swift format lint, swift build, swift test"
swift format lint --strict -r Sources Tests Plugins Package.swift
swift build
swift test
